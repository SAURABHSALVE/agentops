# Placeholders only. Copy the backend variables to the git-ignored backend/.env (or set them in your shell).
# Never commit real values.
# Variables marked (planned) are not read by any code yet; today only CORS_ALLOW_ORIGINS is read (Phase 2).

# ---- Agent / model provider (planned, Phase 3) -------------------------------------------------
# mock   = deterministic, no network, no credentials, labelled "mock, not an LLM"  (default)
# openai = real model calls; needs OPENAI_API_KEY and OPENAI_MODEL
AGENT_PROVIDER=mock

# Backend environment ONLY. Never expose to the browser (no NEXT_PUBLIC_ prefix). Never commit or log.
OPENAI_API_KEY=REPLACE_ME_sk-your-key-here
# Chosen and verified against the current OpenAI docs in Phase 3B; deliberately not pre-filled.
OPENAI_MODEL=REPLACE_ME_after_phase3b_verification

# ---- Bounds on every model-driven run (planned, Phase 3) ---------------------------------------
AGENT_MAX_ROUNDS=6
AGENT_MAX_TOTAL_TOKENS=20000       # abort the investigation honestly when exceeded
OPENAI_MAX_OUTPUT_TOKENS=1500
OPENAI_TIMEOUT_SECONDS=30
TOOL_TIMEOUT_SECONDS=5
TOOL_RESULT_MAX_BYTES=16384

# ---- Telemetry source (planned) ----------------------------------------------------------------
# simulated = deterministic simulator (default; always labelled as simulated)
# cloudwatch = optional real read-only telemetry, only if time and IAM permissions allow
TELEMETRY_SOURCE=simulated

# ---- Storage (planned, Phase 4) ----------------------------------------------------------------
# local = persistent local store behind the repository interface (default)
# dynamodb = optional AWS backend, only if adopted
STORAGE_MODE=local
LOCAL_DATA_DIR=./.data
DYNAMODB_TABLE=agentops-dev

# ---- AWS (OPTIONAL: deployment, DynamoDB, CloudWatch only) -------------------------------------
# Not needed for local mock or OpenAI mode. Use a named least-privilege profile or SSO.
# Do NOT use the root user or root access keys. Do not put access keys in this file.
AWS_PROFILE=agentops-dev
AWS_REGION=us-east-1

# ---- API / UI (CORS_ALLOW_ORIGINS is read today) -----------------------------------------------
API_BASE_URL=http://localhost:8000
CORS_ALLOW_ORIGINS=http://localhost:3000
